# 프론트엔드 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한다. (.env 는 .gitignore 대상)
#   cp .env.example .env
#
# ⚠ 여기 넣는 값은 전부 빌드 결과물(JS 번들)에 문자열로 박혀
#   브라우저에서 누구나 볼 수 있다. 비밀값을 절대 넣지 말 것.
#   (client secret 같은 것은 백엔드 환경변수로만 다룬다)

# API 기본 경로.
# 로컬(vite dev 서버)과 배포(nginx) 모두 /api 로 시작하는 요청을
# 경로 변경 없이 백엔드로 넘기므로 양쪽 값이 같다.
# 백엔드 컨트롤러 매핑이 /api/v1/** 이라 여기에 맞춘다.
VITE_API_BASEURL=/api/v1

# 로컬 개발 시 이 앱이 뜨는 주소. OAuth redirect_uri 를 만드는 데 쓰인다.
# (실제 요청을 프록시할 대상 서버는 vite.config.ts 의 proxy target 에 있다)
VITE_FRONTEND_URL=http://localhost:5173

# Roblox OAuth. 소셜 로그인을 실제로 시험할 때만 채우면 된다.
# 비워두면 로그인 버튼만 동작하지 않고 나머지 화면은 정상이다.
VITE_AUTHORIZATION_URL=https://apis.roblox.com/oauth/v1/authorize
VITE_CLIENT_ID=
